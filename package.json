{
  "name": "camelup-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx shared/game.test.ts"
  },
  "dependencies": {
    "express": "4.21.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "three": "0.169.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/three": "0.169.0",
    "concurrently": "9.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
